# Пример настроек Otti.
# Настоящие значения хранятся в файле .env.local (он не попадает на GitHub)
# и в настройках проекта на Vercel (Settings → Environment Variables).

# ── База данных ──
# На Vercel эти две переменные добавляются сами, когда вы подключаете Neon во вкладке Storage.
# На компьютере их можно не задавать: тогда используется локальная база в папке .data.
# DATABASE_URL=postgresql://...
# DATABASE_URL_UNPOOLED=postgresql://...

# ── Вход и регистрация ──
# Секретный ключ для защиты сессий. На Vercel обязателен, на компьютере — нет.
# Получить: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BETTER_AUTH_SECRET=...

# Адрес сайта. Нужен, только если подключите свой домен (например, https://otti.ru).
# BETTER_AUTH_URL=https://...

# ── ИИ-репетитор ──
# Главный выключатель: false — ИИ выключен на всём сайте (уроки, словарь и ошибки работают).
# AI_ENABLED=true

# Основной провайдер: gigachat, openrouter, yandex или mock (тестовый режим без настоящего ИИ).
# Если не указан: при наличии ключа GigaChat — gigachat, на компьютере без ключей — mock.
# AI_PROVIDER=gigachat

# Запасной провайдер — если основной не ответил (необязательно).
# AI_FALLBACK_PROVIDER=openrouter

# GigaChat (Сбер): «Ключ авторизации» из проекта GigaChat API в личном кабинете Studio.
# GIGACHAT_AUTH_KEY=...
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2

# OpenRouter: ключ со страницы https://openrouter.ai/keys. Модель openrouter/free — бесплатная.
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=openrouter/free
# Адрес другого сервиса с таким же форматом запросов (например, посредника). Обычно не нужен.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# YandexGPT (платно): API-ключ сервисного аккаунта и идентификатор каталога Yandex Cloud.
# YANDEX_API_KEY=...
# YANDEX_FOLDER_ID=...
# YANDEX_MODEL=yandexgpt-lite

# Лимиты — защита от неожиданных расходов. Ниже — значения по умолчанию.
# AI_USER_DAILY_LIMIT=30        # сообщений на ученика в день
# AI_NEW_USER_DAILY_LIMIT=15    # то же для аккаунтов моложе суток (защита от массовых регистраций)
# AI_USER_PER_MINUTE=6          # сообщений на ученика в минуту
# AI_GLOBAL_DAILY_LIMIT=500     # сообщений на весь сайт в день
# AI_MAX_INPUT_CHARS=500        # длина сообщения ученика, символов
# AI_MAX_OUTPUT_TOKENS=800      # длина ответа ИИ, токенов
# AI_HISTORY_MESSAGES=12        # сколько прошлых сообщений разговора видит ИИ
# AI_THREAD_MAX_MESSAGES=60     # максимум сообщений в одном разговоре

# Надёжность: повторы при временных сбоях ИИ (тайм-аут, 429, 500–504, обрыв связи).
# AI_TIMEOUT_SECONDS=25         # сколько ждать одну попытку, секунд
# AI_MAX_RETRIES=2              # сколько раз повторить запрос при временном сбое
# AI_TOTAL_TIMEOUT_SECONDS=55   # сколько всего ждать ответа со всеми повторами, секунд

# ── Владелец сайта ──
# Ваш e-mail (или несколько через запятую): только этим аккаунтам на странице /status
# видны подробности и кнопка «Проверить связь с Отти». На компьютере (npm run dev) — видны всем.
# ADMIN_EMAILS=you@example.com

# E-mail для вопросов о персональных данных — показывается на странице /privacy (необязательно).
# CONTACT_EMAIL=you@example.com
